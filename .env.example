# Copie este arquivo para ".env" e ajuste os valores.
# O ".env" real fica de fora do Git (veja .gitignore) — só o .env.example
# é versionado.

# ============================================================================
# Geral
# ============================================================================
TZ=America/Sao_Paulo

# UID/GID do seu usuário no Pop!_OS (rode `id -u` e `id -g` no terminal).
# Evita problemas de permissão nas pastas montadas por todos os containers.
PUID=1000
PGID=1000

# ============================================================================
# Armazenamento — configuração dos apps (bancos internos, ajustes, cache)
# ============================================================================
# Raiz onde cada serviço grava sua própria pasta de config, ex.:
# ${CONFIG_ROOT}/radarr, ${CONFIG_ROOT}/sonarr, ${CONFIG_ROOT}/prowlarr...
# É pequeno e não precisa estar no mesmo disco do acervo de mídia.
CONFIG_ROOT=./config

# Cache de transcodificação do Jellyfin: dado descartável, recriado sob
# demanda. Vale isolar do CONFIG_ROOT e, se tiver, apontar para um SSD/NVMe.
JELLYFIN_CACHE_DIR=./config/jellyfin-cache

# ============================================================================
# Armazenamento — acervo de mídia
# ============================================================================
# ATENÇÃO — leia antes de mudar:
# DATA_ROOT é UMA ÚNICA raiz que contém tanto os downloads em andamento
# (torrents/) quanto a biblioteca final organizada (media/). Isso é
# proposital: para o Radarr/Sonarr conseguirem mover um arquivo baixado
# para a biblioteca via HARDLINK (instantâneo, sem I/O extra nem duplicar
# espaço em disco) em vez de COPIAR o arquivo inteiro, origem e destino
# precisam estar no MESMO sistema de arquivos/partição.
#
# Aponte para o ponto de montagem do disco/array dedicado ao acervo (ex.:
# um HD/SSD grande ou um pool RAID/ZFS em /mnt). NÃO separe torrents/ e
# media/ em discos diferentes — isso quebra o hardlink e volta a copiar
# (e reescrever no disco) cada Remux 4K inteiro toda vez que o Radarr/Sonarr
# importa um arquivo.
DATA_ROOT=/mnt/media-vault-data

# Dentro de DATA_ROOT a stack usa esta estrutura (crie as pastas na mão ou
# deixe os próprios apps criarem no primeiro uso):
#   DATA_ROOT/torrents/movies     -> categoria "movies" no qBittorrent
#   DATA_ROOT/torrents/tv         -> categoria "tv" no qBittorrent
#   DATA_ROOT/torrents/incomplete -> downloads incompletos (opcional)
#   DATA_ROOT/media/movies        -> pasta raiz de filmes, configurada no Radarr
#   DATA_ROOT/media/tv            -> pasta raiz de séries, configurada no Sonarr

# Bibliotecas extras, opcionais, montadas somente leitura no Jellyfin (não
# entram no fluxo de hardlink do Radarr/Sonarr, são só pastas a mais pra
# navegar/assistir):
DATA_ROOT_EXTERNA=/caminho/para/um/HD/externo
DATA_ROOT_BACKUP=/caminho/para/uma/pasta/de/backup

# ============================================================================
# Portas — mude se algum número já estiver em uso no host
# ============================================================================
JELLYFIN_PORT=8096
PROWLARR_PORT=9696
RADARR_PORT=7878
SONARR_PORT=8989
BAZARR_PORT=6767
JELLYSEERR_PORT=5055
QBITTORRENT_PORT=8080
# Porta de conexões de entrada de peers (TCP+UDP). Mantenha igual à porta
# configurada dentro do qBittorrent (o app lê TORRENTING_PORT sozinho) e
# encaminhe essa porta no roteador para melhor conectividade com a rede torrent.
QBITTORRENT_TORRENTING_PORT=6881
# Porta do Byparr (solver de Cloudflare, fala a API "FlareSolverr")
BYPARR_PORT=8191
# Frequência de sincronização do Recyclarr com TRaSH Guides (sintaxe cron)
RECYCLARR_CRON=@daily
# Scraper que devolve o acesso ao OpenSubtitles.org pro Bazarr+ (configure a
# "Scraper Service URL" do provedor OpenSubtitles.org como
# http://opensubtitles-scraper:8000)
OPENSUBTITLES_SCRAPER_PORT=8000

# ============================================================================
# Unpackerr — chaves de API do Radarr/Sonarr
# ============================================================================
# Deixe em branco no primeiro "docker compose up -d". Depois que os
# containers subirem, entre em Radarr/Sonarr > Configurações > Geral >
# Segurança, copie a "API Key" de cada um, cole aqui e rode
# "docker compose up -d" novamente para o Unpackerr pegar as chaves.
RADARR_API_KEY=
SONARR_API_KEY=
