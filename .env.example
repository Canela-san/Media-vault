# Copie este arquivo para ".env" e ajuste os valores.
# O ".env" real fica de fora do Git (veja .gitignore) — só o .env.example
# é versionado.

# ----------------------------------------------------------------------------
# Geral
# ----------------------------------------------------------------------------

# Fuso horário usado pelos containers
TZ=America/Sao_Paulo

# UID/GID do seu usuário no Pop!OS (rode `id -u` e `id -g` no terminal).
# Isso evita problemas de permissão nas pastas montadas.
PUID=1000
PGID=1000

# ----------------------------------------------------------------------------
# Pastas de mídia (host)
# ----------------------------------------------------------------------------
# Cada MEDIA_PATH_N vira uma pasta montada nos containers. Adicione quantas
# precisar seguindo o mesmo padrão (MEDIA_PATH_3, MEDIA_PATH_4, ...) e
# replique a linha correspondente em docker-compose.yml.
#
# Quais dessas pastas viram bibliotecas "públicas" ou de acesso restrito é
# decidido depois, dentro do próprio Jellyfin (Painel > Usuários > Acesso a
# bibliotecas) — não há nada disso hardcoded aqui. Veja docs/controle-de-acesso-por-usuario.md.

MEDIA_PATH_1=/home/SEU_USUARIO/Videos/biblioteca-1
MEDIA_PATH_2=/home/SEU_USUARIO/Videos/biblioteca-2

# ----------------------------------------------------------------------------
# Jellyfin
# ----------------------------------------------------------------------------
JELLYFIN_PORT=8096
JELLYFIN_CONFIG_DIR=./config/jellyfin/config
JELLYFIN_CACHE_DIR=./config/jellyfin/cache

# ----------------------------------------------------------------------------
# tinyMediaManager
# ----------------------------------------------------------------------------
TMM_WEBUI_PORT=5800
TMM_CONFIG_DIR=./config/tinymediamanager
